# ASCII framing.
@kenwood
# frames split across reads, several in one read, CR/LF between frames
R "FA000140"
R "74000;FB00007074000;\r\n"
R "\r\nMD3;"
= rx=14074000 unsel=7074000 mode=CW frames=3
# binary data inside a frame: dropped, the rest ("14074000;") is an unknown command
R "FA000\x0114074000;"
= rx=14074000 dropped=1 frames=4
# overlong frame
R "XX0123456789012345678901234567890123456789012345678901234567890123456789;MD2;"
= mode=USB dropped=2
# client data is framed separately from radio data
H1 "FA"
R "FA00014076000;"
H1 ";"
= rx=14076000 replies=0
