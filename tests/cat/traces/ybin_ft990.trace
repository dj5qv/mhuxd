# Yaesu FT-990: 16 byte records like the FT-1000MP, frequency in 3 bytes (10 Hz units). The
# current data are two records (32 bytes), the first one is the display.
@ybin model=ft990
0.000 H1 00 00 00 02 10
0.070 R  11 15 79 a8 00 00 00 01 00 00 00 00 00 00 00 00 11 05 73 b4 00 00 00 00 00 00 00 00 00 00 00 00
= client=H1 busy=none rx=14074000 mode=USB

# Status flags: bit 0 split, bit 1 VFO B
0.100 H1 00 00 00 03 10
0.160 R  11 15 79 a8 00 00 00 02 00 00 00 00 00 00 00 00 11 15 be 68 00 00 00 05 80 00 00 00 00 00 00 00
= rx=14074000 mode=CW unsel=14250000 mode_unsel=RTTYR
0.200 H1 00 00 00 00 fa
0.220 R  03 00 00 00 00
= vfo=B split=1 rx=14250000 tx=14074000

