# Yaesu FT-1000, FT-1000D: like the FT-990, current data one record; the VFO B flag doesn't
# work (Hamlib), VFO A is assumed until a client selects one.
@ybin model=ft1000
10.000 H1 00 00 00 03 10
10.070 R  11 15 79 a8 00 00 00 01 00 00 00 00 00 00 00 00 11 15 be 68 00 00 00 00 00 00 00 00 00 00 00 00
= rx=14074000 mode=USB unsel=14250000 mode_unsel=LSB
10.100 H1 00 00 00 00 fa
10.120 R  03 00 00 00 00
= vfo=A split=1 tx=14250000
10.200 H1 00 00 00 01 05
= vfo=B rx=14250000 mode=LSB
10.400 H1 00 00 00 02 10
10.440 R  11 15 c0 5c 00 00 00 00 00 00 00 00 00 00 00 00
= busy=none rx=14255000 mode=LSB unsel=14074000
