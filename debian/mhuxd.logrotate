/var/log/mhuxd/*log {
        weekly
        missingok
        rotate 7
        sharedscripts
        postrotate
                if [ -e /var/run/mhuxd/mhuxd.pid ]; then
                        invoke-rc.d --quiet mhuxd force-reload > /dev/null
                fi
        endscript
        compress
	delaycompress
        notifempty
}

