#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@ --with autoreconf


# The Svelte web UI is shipped pre-built (webui/svelte/dist), so the package
# build needs neither npm nor network access. Nothing to override here.

override_dh_installudev:
	dh_installudev --priority 59 -n

# "make deb" (see Makefile.am) passes a snapshot version in MHUXD_DEB_VERSION,
# which replaces the debian/changelog version in the generated .deb files.
# Plain dpkg-buildpackage runs are unaffected.
override_dh_gencontrol:
	dh_gencontrol $(if $(MHUXD_DEB_VERSION),-- -v$(MHUXD_DEB_VERSION))

# install-data-local (src/Makefile.am) creates the runtime dir under
# $(RUNDIR) for plain "make install" use. On Debian it's recreated at
# boot by debian/mhuxd.tmpfile instead, so drop the empty dir lintian
# flags as dir-or-file-in-var-run.
override_dh_auto_install:
	dh_auto_install
	rmdir --ignore-fail-on-non-empty --parents debian/mhuxd/var/run/mhuxd

